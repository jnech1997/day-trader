# Copy this file to `.env` and replace the placeholder values before running the agents.

# --- Alpaca (paper account - required for paper trading/backtests) ---
APCA_PAPER_API_KEY_ID=your-paper-key
APCA_PAPER_API_SECRET_KEY=your-paper-secret

# --- Alpaca (live account - only required when running live mode) ---
APCA_API_KEY_ID=your-live-key
APCA_API_SECRET_KEY=your-live-secret

# --- BinanceUS (live crypto trading - optional, used when live mode + crypto enabled) ---
BINANCE_API_KEY=your-binance-key
BINANCE_SECRET_KEY=your-binance-secret

# You can add any additional environment overrides below.
